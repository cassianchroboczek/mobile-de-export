{
  "manifest_version": 3,
  "name": "mobile.de Inserat kopieren",
  "version": "1.0.0",
  "description": "Kopiert die wichtigsten Infos eines mobile.de-Inserats als Text in die Zwischenablage (ohne Fotos).",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inserat kopieren",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
